# ==============================================================================
# DocuMind SLM — Environment Configuration
# ==============================================================================

# Supabase API Settings
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Local AI Engine Settings & Authentication
AI_ENGINE_HOST=0.0.0.0
AI_ENGINE_PORT=8000
MODEL_PATH=./models/llama-3.2-3b-instruct-q4_k_m.gguf
N_GPU_LAYERS=-1
CONTEXT_SIZE=4096

# Set to 'true' only if evaluating locally without downloading the 2GB GGUF model weights
MOCK_FALLBACK=false

# Secret token used by Next.js and API clients to authenticate with FastAPI
DOCUMIND_API_KEY=documind-secure-hackathon-key-2026

# Storage Settings
STORAGE_BUCKET=document-vault

# Next.js -> FastAPI Engine URL (Used by Vercel to communicate with the AI Engine backend)
# In local dev: http://127.0.0.1:8000
# In Vercel production: Set this to your deployed FastAPI URL (Render, Railway, Fly.io, etc.)
AI_ENGINE_URL=http://127.0.0.1:8000
