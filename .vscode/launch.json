{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "DocuMind: FastAPI Engine",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "app.main:app",
        "--reload",
        "--port",
        "8000",
        "--host",
        "127.0.0.1"
      ],
      "cwd": "${workspaceFolder}/services/ai-engine",
      "jinja": true
    },
    {
      "name": "DocuMind: Next.js Frontend",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}/web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"]
    }
  ]
}
