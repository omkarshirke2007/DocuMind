{
  "python.defaultInterpreterPath": "${workspaceFolder}/services/ai-engine/venv/Scripts/python.exe",
  "python.analysis.extraPaths": [
    "${workspaceFolder}/services/ai-engine"
  ],
  "typescript.tsdk": "web/node_modules/typescript/lib",
  "editor.formatOnSave": true,
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "files.exclude": {
    "**/.git": true,
    "**/.svn": true,
    "**/.hg": true,
    "**/CVS": true,
    "**/.DS_Store": true,
    "**/Thumbs.db": true,
    "**/__pycache__": true,
    "**/.pytest_cache": true
  }
}
